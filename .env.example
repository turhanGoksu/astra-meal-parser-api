# Copy this file to .env and fill in real values. Never commit .env.

# Parser model (GGUF). Downloaded into MODEL_DIR at runtime; in Docker this
# directory is a volume, so the weights are never baked into the image.
MODEL_REPO_ID=Turhan123/astra-meal-parser-gguf
MODEL_FILENAME=astra-meal-parser-1.5b-q4_k_m.gguf
MODEL_DIR=models

# Grammar-constrained JSON decoding. Off by default: same output on real meals,
# ~50% slower, and it can hide failures on non-meal input (see app/parser.py).
PARSER_USE_GRAMMAR=false

# PostgreSQL + pgvector (docker compose reads these for the db service)
POSTGRES_USER=astra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astra_meals
# The API and scripts build their connection URL from the values above
# (host "localhost" by default; docker compose sets POSTGRES_HOST=db).
# Set DATABASE_URL only to override that, e.g. for an external database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Embedding model, chosen on the dev set (see README). e5 models expect the
# "query: " prefix on every text: keep the quotes, the trailing space matters.
# Changing either value requires re-running python -m scripts.ingest_foods.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_PREFIX="query: "

# Optional LLM judge (Step 8): off | groq | gemini. Only item names are sent.
# Model names and free-tier requests-per-minute limits change over time, so
# they live here, not in code (same variable names as Project 4).
LLM_JUDGE_PROVIDER=off
GROQ_API_KEY=
GROQ_MODEL=
GROQ_RPM=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RPM=
